---
// Home hero: what Rewind does, the problem it solves, one verified property, and a small real preview.
import render from '../data/capture/source/render.json';
import manifest from '../data/capture/manifest.json';
import Wordmark from './Wordmark.astro';
import Terminal from './Terminal.astro';
import { heroExcerpt, fact } from '../lib/site';
import { WIDTHS } from '../lib/investigation';

const lines = Object.fromEntries(WIDTHS.map((w) => [w, heroExcerpt(w)]));
---
<section id="top" class="hero" aria-labelledby="top-title">
  <div class="intro">
    <Wordmark />
    <h1 id="top-title" class="display">Record a Node.js run once. Then ask <em>why</em>.</h1>
    <p class="sub">{render.TAGLINE} A stack trace says where an error surfaced. Rewind says which request caused it, who scheduled the failing work, and who changed the state it read.</p>
    <div class="actions">
      <a class="btn primary" href="/investigation/">Open the investigation</a>
      <a class="btn" href="/docs/#install">Get Started</a>
    </div>
    <p class="fact"><b>{fact.title}</b> <span>{fact.text}</span></p>
  </div>
  <div class="exhibit">
    <Terminal command={manifest.views['why-bad'].command} lines={lines} label="Real output of rewind why bad --evidence, five of its findings" />
    <p class="caption">Real Rewind output, five of its findings. <a href="/investigation/?step=3">See the full investigation</a></p>
  </div>
</section>

<style>
  .hero { max-width: var(--page-max); margin-inline: auto; padding: var(--s-8) var(--gutter) var(--s-7); display: grid; gap: var(--s-7); }
  @media (min-width: 960px) { .hero { grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr); align-items: center; padding-top: var(--s-9); } }
  h1 { margin: var(--s-5) 0 var(--s-4); }
  .sub { margin: 0; max-width: 50ch; font-size: 18px; color: var(--text-2); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin: var(--s-6) 0; }
  .btn { display: inline-flex; align-items: center; gap: 0.5ch; min-height: 48px; padding: 0 var(--s-5); border-radius: 8px; border: 1px solid var(--line); color: var(--text); text-decoration: none; font-weight: 600; transition: transform 100ms var(--ease-out); }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: var(--bg); }
  .btn:active { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) { .btn:hover { border-color: var(--line-strong); background: var(--surface-1); } .btn.primary:hover { background: #A28AFF; border-color: #A28AFF; } }
  .fact { margin: 0; padding-top: var(--s-4); border-top: 1px solid var(--line); display: grid; gap: var(--s-1); font-size: 15px; color: var(--text-2); }
  .fact b { font: 600 17px/1.3 var(--font-display); color: var(--text); }
  .exhibit { min-width: 0; }
  .caption { margin: var(--s-3) 0 0; font-size: 14px; color: var(--text-3); }
</style>
