---
// Home hero (restored layout): what Rewind does on the left, Rewind's real `why` output in a terminal on the right.
import render from '../data/capture/source/render.json';
import manifest from '../data/capture/manifest.json';
import Wordmark from './Wordmark.astro';
import Terminal from './Terminal.astro';
import { heroExcerpt } from '../lib/site';
import { WIDTHS } from '../lib/investigation';

const lines = Object.fromEntries(WIDTHS.map((w) => [w, heroExcerpt(w)]));
---
<section id="top" class="hero" aria-labelledby="top-title">
  <div class="intro">
    <Wordmark />
    <h1 id="top-title" class="display">Record a Node.js run once. Then ask <em>why</em>.</h1>
    <p class="sub">{render.TAGLINE} A stack trace says where an error surfaced. Rewind says which request caused it, who scheduled the failing work, and who changed the state it read, without changing your code.</p>
    <div class="actions">
      <a class="btn primary" href="/investigation/">Open the investigation</a>
      <a class="btn secondary" href="/docs/">Read the documentation</a>
      <a class="btn tertiary" href="#install">Get Started <span aria-hidden="true">→</span></a>
    </div>
  </div>
  <div class="exhibit">
    <Terminal command={manifest.views['why-bad'].command} lines={lines} label="Real output of rewind why bad --evidence, five of its findings" />
    <p class="caption">Real Rewind output, five of its findings. <a href="/investigation/?step=3">See the full investigation</a></p>
  </div>
</section>

<style>
  .hero { max-width: var(--page-max); margin-inline: auto; padding: var(--s-8) var(--gutter) var(--s-7); display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-7); }
  .hero > * { min-width: 0; }
  @media (min-width: 960px) { .hero { grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr); align-items: center; padding-top: var(--s-9); } }
  h1 { margin: var(--s-5) 0 var(--s-4); }
  .sub { margin: 0; max-width: 50ch; font-size: 18px; color: var(--text-2); }
  /* one group, three levels: filled primary, outlined secondary, a compact text action; same height and type */
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3); margin: var(--s-6) 0 0; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5ch; min-height: 44px; padding: 0 var(--s-4);
    border-radius: 6px; border: 1px solid transparent; font: 600 15px/1 var(--font-sans); text-decoration: none; white-space: nowrap;
    transition: transform 100ms var(--ease-out);
  }
  .btn.primary { background: var(--accent); color: var(--bg); }
  .btn.secondary { border-color: var(--line-strong); color: var(--text); }
  .btn.tertiary { padding: 0 var(--s-2); color: var(--accent); }
  .btn:active { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) {
    .btn.primary:hover { background: #A28AFF; }
    .btn.secondary:hover { background: var(--surface-1); }
    .btn.tertiary:hover { text-decoration: underline; text-underline-offset: 4px; }
  }
  .exhibit { min-width: 0; }
  .caption { margin: var(--s-3) 0 0; font-size: 14px; color: var(--text-3); }
  /* phones: the two buttons stack at full width, the text action sits beneath them */
  @media (max-width: 639px) { .sub { font-size: 17px; } .btn.primary, .btn.secondary { flex: 1 1 100%; } .btn.tertiary { padding-left: 0; } }
</style>
