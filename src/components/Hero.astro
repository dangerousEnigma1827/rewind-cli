---
// Home hero, within one viewport: the brand, what Rewind does, one supporting sentence, three actions.
import render from '../data/capture/source/render.json';
import Wordmark from './Wordmark.astro';
---
<section id="top" class="hero" aria-labelledby="top-title">
  <div class="inner">
    <Wordmark />
    <h1 id="top-title" class="display">Record a Node.js run once. Then ask <em>why</em>.</h1>
    <p class="sub">{render.TAGLINE} A stack trace says where an error surfaced. Rewind says which request caused it, who scheduled the failing work, and who changed the state it read, without changing your code.</p>
    <div class="actions">
      <a class="btn primary" href="/investigation/">Open the investigation</a>
      <a class="btn" href="/docs/">Read the documentation</a>
      <a class="btn" href="#get-started">Get Started</a>
    </div>
  </div>
</section>

<style>
  /* never taller than the viewport left under the navigation */
  .hero { display: flex; align-items: center; min-height: min(calc(100svh - var(--nav-h)), 760px); }
  .inner { max-width: var(--page-max); width: 100%; margin-inline: auto; padding: var(--s-7) var(--gutter); }
  h1 { max-width: 15ch; margin: var(--s-5) 0 var(--s-4); }
  .sub { margin: 0; max-width: 56ch; font-size: 19px; line-height: 1.6; color: var(--text-2); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }
  .btn { display: inline-flex; align-items: center; min-height: 48px; padding: 0 var(--s-5); border-radius: 8px; border: 1px solid var(--line); color: var(--text); text-decoration: none; font-weight: 600; transition: transform 100ms var(--ease-out); }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: var(--bg); }
  .btn:active { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) { .btn:hover { border-color: var(--line-strong); background: var(--surface-1); } .btn.primary:hover { background: #A28AFF; border-color: #A28AFF; } }
  @media (max-width: 639px) { .sub { font-size: 17px; } .actions .btn { flex: 1 1 100%; justify-content: center; } .inner { padding-block: var(--s-6); } }
</style>
