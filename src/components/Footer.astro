---
// Footer: on the left, Rewind's block wordmark (render.WORDMARK, the CLI splash) and the attribution; on the right,
// three compact link columns. GitHub is the repository, so it appears once; the demo repository is the judge-facing
// walkthrough.
import render from '../data/capture/source/render.json';
import { REPO, DEMO_REPO } from '../lib/site';
const tones = ['uv-hi', 'uv', 'uv-lo'];
const groups = [
  { title: 'Product', links: [['CLI Commands', '/#commands'], ['Investigation', '/investigation/'], ['Features', '/#features'], ['Install', '/#install']] },
  { title: 'Learn', links: [['Documentation', '/docs/']] },
  { title: 'Project', links: [['GitHub ↗', REPO], ['Demo repository ↗', DEMO_REPO]] },
];
---
<footer>
  <div class="inner">
    <div class="sig">
      <div class="brand" role="img" aria-label="Rewind">
        <svg class="mark" viewBox="0 0 100 100" aria-hidden="true"><g fill="#8D6CFF" stroke="#8D6CFF" stroke-width="6" stroke-linejoin="round"><path d="M12 50 L49 24 L49 76 Z"/><path d="M51 50 L88 24 L88 76 Z"/></g></svg>
        <pre class="wordmark" aria-hidden="true">{render.WORDMARK.map((row, i) => <span class={`wm-${tones[i]}`}>{row}{'\n'}</span>)}</pre>
      </div>
      <p class="attr">Built for <span translate="no">CODEFESTTHON 2026</span></p>
    </div>
    <nav class="cols" aria-label="Footer">
      {groups.map((g) => (
        <div>
          <h2>{g.title}</h2>
          <ul>{g.links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
        </div>
      ))}
    </nav>
  </div>
</footer>

<style>
  footer { margin-top: var(--s-10); border-top: 1px solid var(--line); background: var(--bg); }
  .inner {
    max-width: var(--page-max); margin-inline: auto; padding: var(--s-7) var(--gutter);
    display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-6);
  }
  @media (min-width: 900px) { .inner { grid-template-columns: minmax(0, 1fr) auto; align-items: start; gap: var(--s-8); } }
  .brand { display: flex; align-items: center; gap: var(--s-3); }
  .mark { flex: none; width: 36px; height: auto; }
  /* 38 cells at 11px: about 250px wide, distinct but not dominant */
  .wordmark { margin: 0; font: 400 11px/1 var(--font-mono); letter-spacing: 0; white-space: pre; }
  .wm-uv-hi { color: var(--p-uv-hi); } .wm-uv { color: var(--p-uv); } .wm-uv-lo { color: var(--p-uv-lo); }
  .attr { margin: var(--s-4) 0 0; font: 500 15px/1.4 var(--font-sans); color: var(--text-2); }
  .cols { display: grid; grid-template-columns: repeat(3, auto); gap: var(--s-7); }
  @media (max-width: 479px) { .cols { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-5); } }
  h2 { margin: 0 0 var(--s-2); font: 500 12px/1.4 var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-3); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; }
  a { display: inline-flex; align-items: center; min-height: 40px; color: var(--text-2); text-decoration: none; font-size: 15px; }
  @media (pointer: coarse) { a { min-height: 44px; } }
  @media (hover: hover) and (pointer: fine) { a:hover { color: var(--text); } }
</style>
