---
// Several real commands in one terminal window: one prompt line each, each with its own Copy button.
// Uses the shared terminal script (Copy appears only when the clipboard is available).
interface Props { title: string; commands: { cmd: string; note?: string }[] }
const { title, commands } = Astro.props;
---
<div class="term cmd-list" data-static>
  <div class="term-bar">
    <span class="term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="term-title">{title}</span>
    <span></span>
  </div>
  <ol>
    {commands.map((c) => (
      <li>
        <p class="term-prompt" translate="no"><span class="ps" aria-hidden="true">$</span><code>{c.cmd}</code></p>
        <button class="copy" type="button" data-copy={c.cmd} aria-label={`Copy command: ${c.cmd}`} hidden>Copy</button>
        {c.note && <p class="note">{c.note}</p>}
      </li>
    ))}
  </ol>
</div>

<script>
  import '../scripts/terminal';
</script>

<style>
  ol { list-style: none; margin: 0; padding: var(--s-2) 0; }
  li { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 0 var(--s-3); padding: var(--s-1) var(--s-3) var(--s-1) 0; }
  li + li { border-top: 1px solid var(--line); }
  li .term-prompt { padding: var(--s-2) 0 var(--s-2) var(--s-4); }
  .note { grid-column: 1 / -1; margin: 0 0 var(--s-2); padding-left: calc(var(--s-4) + 2ch); font: 400 13px/1.5 var(--font-sans); color: var(--text-3); max-width: none; }
</style>
