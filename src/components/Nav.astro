---
const links = [
  ['#scenario', 'Scenario'],
  ['#investigate', 'Investigate'],
  ['#how', 'How it works'],
  ['#evidence', 'Evidence'],
  ['#limits', 'Limits'],
  ['#start', 'Get started'],
];
---
<header class="nav">
  <nav aria-label="Sections">
    <a class="mark" href="#top" translate="no"><span aria-hidden="true">◂◂</span> rewind</a>
    <ul>
      {links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
      <li><a href="https://github.com/dangerousEnigma1827/Rewind">GitHub <span aria-hidden="true">↗</span></a></li>
    </ul>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--nav-bg);
    border-bottom: 1px solid var(--nav-rule);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    max-width: var(--page-max);
    height: var(--nav-h);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .mark {
    flex: none;
    font: 700 0.9375rem/1 var(--font-mono);
    color: var(--link);
    text-decoration: none;
  }
  /* Seven links don't fit a phone row: they scroll inside the nav, never the page. */
  ul {
    display: flex;
    gap: 1.25rem;
    min-width: 0;
    margin: 0 0 0 auto;
    padding: 2px;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
    white-space: nowrap;
    font-size: 0.875rem;
  }
  ul a { color: var(--text); text-decoration: none; }
  ul a:hover { color: var(--link); text-decoration: underline; }
</style>
