---
// The Wrong Order Total bug: the orders, what they were charged, the code that causes it, and what plain Node says.
import { Code } from 'astro:components';
import checkout from '../data/capture/source/checkout.js?raw';
import plainNode from '../data/capture/terminal/plain-node.txt?raw';
import manifest from '../data/capture/manifest.json';
import Terminal from './Terminal.astro';
import Evidence from './Evidence.astro';
import { orders, price, charged, WIDTHS } from '../lib/investigation';
import { victims } from '../lib/site';
import { rewindTheme } from '../lib/shiki-theme';

const os = orders();
const c = charged('bad');
const v = victims();
const src = checkout.split('\n');
// Where checkout.js declares, overwrites and uses the shared cart: found in the source (the explanations are ours, ◇).
const MARKS: { line: number; kind: string; title: string; text: string }[] = [];
src.forEach((l, i) => {
  if (/^let currentCart\b/.test(l)) MARKS.push({ line: i + 1, kind: 'shared', title: 'One cart for everyone', text: 'Declared once at module level, so every request in flight shares it.' });
  else if (/^\s+currentCart = /.test(l)) MARKS.push({ line: i + 1, kind: 'write', title: 'Overwritten by each request', text: 'Each order’s loadCart replaces the cart, whoever was using it.' });
  else if (/currentCart\.items/.test(l)) MARKS.push({ line: i + 1, kind: 'use', title: 'Read after a delay', text: 'The payment timer’s callback totals whatever cart is there by then.' });
});
const kindOf = Object.fromEntries(MARKS.map((m) => [m.line, m.kind]));
const transformers = [{ line(this: any, node: any, line: number) {
  if (kindOf[line]) { this.addClassToHast(node, `mark-${kindOf[line]}`); node.properties['data-line'] = line; }
} }];
---
<div class="orders">
  <table>
    <caption class="visually-hidden">The three orders, what they should cost, and what the concurrent run charged</caption>
    <thead><tr><th scope="col">order</th><th scope="col">items</th><th scope="col">expected</th><th scope="col">charged</th></tr></thead>
    <tbody>{os.map((o) => {
      const x = c[o.id];
      return (
        <tr>
          <th scope="row" translate="no">{o.id}</th>
          <td translate="no">{o.items.map((s) => `${s} $${price(s)}`).join(' + ')}{o.coupon && `, coupon ${o.coupon}`}</td>
          <td class="num">${o.expected}</td>
          {x.crash ? <td class="bad"><span aria-hidden="true">✖</span> crashed</td>
            : x.amount === o.expected ? <td class="num ok">${x.amount} <span aria-hidden="true">✓</span><span class="visually-hidden">correct</span></td>
            : <td class="num bad">${x.amount} <span aria-hidden="true">✗</span><span class="visually-hidden">wrong</span></td>}
        </tr>
      );
    })}</tbody>
  </table>
  <Evidence levels={['authored', 'observed']} note="expected: prices summed, coupon as checkout.js applies it · charged: the run’s own log lines" />
</div>

<div class="code-split">
  <figure class="editor" aria-label="demo/checkout.js">
    <div class="term-bar">
      <span class="term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="term-title" translate="no">demo/checkout.js</span>
      <span></span>
    </div>
    <div class="editor-body">
      <div class="editor-scroll" id="checkout-src" tabindex="0" aria-label="Source of demo/checkout.js, scrollable" translate="no">
        <Code code={checkout} lang="js" theme={rewindTheme as any} transformers={transformers} />
      </div>
    </div>
  </figure>
  <ol class="lines" aria-label="Important lines">
    {MARKS.map((m) => (
      <li class={`mark-${m.kind}`}>
        <button type="button" class="jump" data-line={m.line} aria-controls="checkout-src">
          <span class="ln">Line {m.line}</span> <span class="lt">{m.title}</span>
        </button>
        <code class="snippet" translate="no">{src[m.line - 1].trim()}</code>
        <p>{m.text}</p>
      </li>
    ))}
  </ol>
</div>

<div class="trace">
  <Terminal command={manifest.plain_node.command} ansi={Object.fromEntries(WIDTHS.map((w) => [w, plainNode]))} label="Plain Node output of the concurrent run" />
  <div>
    <h3>What this trace can’t tell you</h3>
    <ul class="notes">
      <li><b>Which order failed.</b> No order id appears.</li>
      <li><b>Which request.</b> The stack starts at a timer callback.</li>
      <li><b>Who changed the cart.</b> <code>loadCart</code> is not on the stack.</li>
      <li><b>That <span translate="no">{v.overcharge.order.id}</span>’s total is wrong.</b> Nothing flags it.</li>
    </ul>
  </div>
</div>

<script>
  // "Line N" buttons scroll the editor to that line, inside the editor (never the page).
  for (const b of document.querySelectorAll<HTMLButtonElement>('.jump')) {
    b.addEventListener('click', () => {
      const box = document.getElementById(b.getAttribute('aria-controls')!)!;
      const line = box.querySelector<HTMLElement>(`[data-line="${b.dataset.line}"]`);
      if (line) box.scrollTo({ top: line.offsetTop - box.clientHeight / 3 });
    });
  }
</script>

<style>
  .orders { margin-bottom: var(--s-8); overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: 16px; font-variant-numeric: tabular-nums; }
  th, td { text-align: left; padding: var(--s-3) var(--s-5) var(--s-3) 0; border-bottom: 1px solid var(--line); }
  thead th { font: 500 12px/1.3 var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-3); }
  tbody th { font: 600 16px/1.3 var(--font-mono); }
  td:nth-child(2) { color: var(--text-2); }
  .ok { color: var(--ink-ok); } .bad { color: var(--ink-err); font-weight: 600; }
  @media (max-width: 639px) { td:nth-child(2) { font-size: 14px; } th, td { padding-right: var(--s-3); } }

  /* the editor takes the height of the explanations beside it; its content scrolls inside */
  .code-split { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-5); margin-bottom: var(--s-8); }
  .code-split > * { min-width: 0; }
  @media (min-width: 960px) { .code-split { grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); align-items: stretch; } }
  /* an editor window: the terminal's frame, not its capture rules */
  .editor { display: flex; flex-direction: column; min-height: 360px; margin: 0; background: var(--term-bg); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
  /* the scroll layer fills the editor body, so the source never adds height: the explanations set it */
  .editor-body { position: relative; flex: 1; min-height: 0; }
  .editor-scroll { position: absolute; inset: 0; overflow: auto; overscroll-behavior: contain; }
  @media (max-width: 959px) { .editor { min-height: 0; } .editor-body { height: 360px; flex: none; } }
  .editor-body :global(pre) { margin: 0; padding: var(--s-4) 0; overflow: visible !important; min-width: max-content; font: 400 13px/1.7 var(--font-mono); background: transparent !important; counter-reset: ln; }
  .editor-body :global(.line) { display: inline-block; min-width: 100%; padding-right: var(--s-4); box-sizing: border-box; counter-increment: ln; }
  /* line numbers from CSS counters: not part of the source text */
  .editor-body :global(.line::before) { content: counter(ln); display: inline-block; width: 3.5ch; margin-right: 2ch; text-align: right; color: var(--text-3); user-select: none; }
  .editor-body :global(.line.mark-shared) { box-shadow: inset 3px 0 0 var(--mark-uv); background: color-mix(in oklab, var(--mark-uv) 14%, transparent); }
  .editor-body :global(.line.mark-write) { box-shadow: inset 3px 0 0 var(--mark-write); background: color-mix(in oklab, var(--mark-write) 16%, transparent); }
  .editor-body :global(.line.mark-use) { box-shadow: inset 3px 0 0 var(--mark-err); background: color-mix(in oklab, var(--mark-err) 14%, transparent); }

  .lines { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-5); align-content: start; }
  .lines li { min-width: 0; }
  .lines li { padding-left: var(--s-4); box-shadow: inset 3px 0 0 var(--k); }
  .lines .mark-shared { --k: var(--mark-uv); } .lines .mark-write { --k: var(--mark-write); } .lines .mark-use { --k: var(--mark-err); }
  .jump {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--s-2); min-height: 44px; padding: 0; text-align: left;
    background: none; border: 0; color: var(--text); cursor: pointer; font: 600 17px/1.3 var(--font-display);
  }
  .ln { font: 500 13px/1 var(--font-mono); color: var(--text-3); }
  @media (hover: hover) and (pointer: fine) { .jump:hover .lt { text-decoration: underline; text-underline-offset: 4px; } }
  .snippet { display: block; margin: 0 0 var(--s-2); overflow-x: auto; white-space: pre; font: 400 12.5px/1.6 var(--font-mono); color: var(--text-2); }
  .lines p { margin: 0; font-size: 15px; color: var(--text-2); }

  .trace { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-6); }
  .trace > * { min-width: 0; }
  @media (min-width: 960px) { .trace { grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); align-items: start; } }
  h3 { margin: 0 0 var(--s-3); }
  .notes { margin: 0; padding-left: 1.25rem; display: grid; gap: var(--s-2); color: var(--text-2); }
  .notes b { color: var(--text); }
</style>
