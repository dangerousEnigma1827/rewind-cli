---
// A terminal window around a real capture (plan §5.5), rendered statically by the one renderer (lib/terminal.ts).
// `ansi` is a whole capture per width; `lines` is an already-cut excerpt of one (the hero). Output is never altered.
import { renderSpans, type TermLine } from '../lib/terminal';

interface Props { command: string; ansi?: Record<number, string>; lines?: Record<number, TermLine[]>; diff?: boolean; label?: string }
const { command, ansi, lines, diff = false, label } = Astro.props;
const byWidth: Record<number, TermLine[]> = lines ?? Object.fromEntries(Object.entries(ansi!).map(([w, a]) => [w, renderSpans(a, { diff })]));
const widths = Object.keys(byWidth).map(Number).sort((a, b) => b - a);
---
<figure class="term" data-static aria-label={label ?? `Terminal: ${command}`}>
  <div class="term-bar">
    <span class="term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="term-title" translate="no" aria-hidden="true">{command}</span>
    <button class="copy" type="button" data-copy={command} aria-label={`Copy command: ${command}`} hidden>Copy</button>
  </div>
  <div class="term-body">
    <p class="term-prompt" translate="no"><span class="ps" aria-hidden="true">$</span><code>{command}</code></p>
    {widths.map((w) => (
      <pre class={`w${w}`} translate="no" tabindex="0" aria-label={`Output of ${command}`}>{byWidth[w].map((l) => (
        <>{l.segs.map((s) => (s.cls ? <span class={s.cls}>{s.text}</span> : s.text))}{'\n'}</>
      ))}</pre>
    ))}
    <p class="term-more" aria-live="off" hidden></p>
  </div>
</figure>

<script>
  import '../scripts/terminal';
</script>
