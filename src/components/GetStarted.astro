---
// §4.1 #7: only commands the M6 fresh-clone run verified.
import CommandLine from './CommandLine.astro';
import { install, tour } from '../lib/depth';
import { REPO, blob, short } from '../lib/site';
---
<div class="cols">
  <div>
    <h3>Install</h3>
    <p class="req">Node.js ≥ 20 and Python ≥ 3.12.</p>
    <ol class="cmds">{install.map((c) => <li><div class="term"><CommandLine command={c.cmd} /></div>{c.note && <p class="note">{c.note}</p>}</li>)}</ol>
  </div>
  <div>
    <h3>Run the tour</h3>
    <ol class="cmds">{tour.map((c) => <li><div class="term"><CommandLine command={c} /></div></li>)}</ol>
  </div>
</div>
<p class="links"><a href={REPO}>Repository <span aria-hidden="true">↗</span></a> · <a href={blob('docs/ARCHITECTURE.md')}>docs/ARCHITECTURE.md</a> · <a href={blob('spikes/RESULTS.md')}>spikes/RESULTS.md</a></p>

<style>
  .cols { display: grid; gap: 2rem; }
  @media (min-width: 960px) { .cols { grid-template-columns: 1fr 1fr; } }
  h3 { margin: 0 0 0.5rem; font-size: 1.0625rem; }
  .req { margin: 0 0 1rem; }
  .cmds { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.5rem; }
  .cmds .term { padding-bottom: 0.5rem; }
  .note { margin: 0.25rem 0 0; font-size: 0.8125rem; color: var(--ink-mute); }
  .links { margin: 2rem 0 0; }
  .links a { display: inline-flex; align-items: center; min-height: 44px; }
</style>
