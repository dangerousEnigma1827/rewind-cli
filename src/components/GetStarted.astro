---
// Installation: the commands verified on fresh clones (see docs/claims.md), then the tour. One repository link.
import CommandLine from './CommandLine.astro';
import { install, tour } from '../lib/depth';
import { REPO } from '../lib/site';
---
<p class="req">Requires Node.js ≥ 20 and Python ≥ 3.12. Source: <a href={REPO}>github.com/dangerousEnigma1827/Rewind</a></p>
<div class="cols">
  <div>
    <h3>Install</h3>
    <ol class="cmds">{install.map((c) => <li><CommandLine command={c.cmd} />{c.note && <p class="note">{c.note}</p>}</li>)}</ol>
  </div>
  <div>
    <h3>Run the tour</h3>
    <ol class="cmds">{tour.map((c) => <li><CommandLine command={c} /></li>)}</ol>
  </div>
</div>

<style>
  .req { margin: 0 0 var(--s-6); }
  .req a { overflow-wrap: anywhere; }
  .cols { display: grid; gap: var(--s-6); }
  @media (min-width: 960px) { .cols { grid-template-columns: 1fr 1fr; } }
  h3 { margin: 0 0 var(--s-3); }
  .cmds { margin: 0; padding: 0; list-style: none; display: grid; gap: var(--s-2); }
  .note { margin: var(--s-1) 0 var(--s-2); font-size: 14px; color: var(--text-3); }
</style>
