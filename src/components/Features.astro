---
// Three boxes: two sourced metrics and the evidence levels.
import { testMetric, eventMetric } from '../lib/home';
---
<section id="features" class="features" aria-labelledby="features-title">
  <h2 id="features-title" class="visually-hidden">What Rewind does</h2>
  <ul>
    <li>
      <p class="big"><span class="num">{testMetric.big}</span> <span class="unit">{testMetric.unit}</span></p>
      <p>{testMetric.text}</p>
      <p class="src">Rewind’s own test suite, at the published version</p>
    </li>
    <li>
      <p class="big"><span class="num">{eventMetric.big}</span> <span class="unit">{eventMetric.unit}</span></p>
      <p>{eventMetric.text}</p>
      <p class="src">Measured in Rewind’s experiment E6</p>
    </li>
    <li>
      <h3>Evidence, graded</h3>
      <p class="levels" aria-label="Evidence levels">
        <span class="lv observed"><span aria-hidden="true">●</span> Observed</span>
        <span class="lv derived"><span aria-hidden="true">◆</span> Derived</span>
        <span class="lv inferred"><span aria-hidden="true">?</span> Inferred</span>
      </p>
      <p>Every finding is marked observed, derived or inferred. When Rewind cannot see something, such as a variable read, it says so.</p>
    </li>
  </ul>
</section>

<style>
  .features { max-width: var(--page-max); margin-inline: auto; padding: var(--s-6) var(--gutter) 0; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-4); }
  @media (min-width: 900px) { ul { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  li { display: flex; flex-direction: column; gap: var(--s-3); padding: var(--s-6); background: var(--surface-1); border: 1px solid var(--line); border-radius: 12px; }
  li p { margin: 0; font-size: 16px; color: var(--text-2); }
  .big { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--s-2); color: var(--text) !important; }
  .num { font: 600 48px/1 var(--font-display); letter-spacing: -0.03em; }
  .unit { font: 600 20px/1.3 var(--font-display); }
  h3 { margin: 0; font-size: 24px; }
  .src { margin-top: auto !important; padding-top: var(--s-2); font: 400 13px/1.5 var(--font-mono) !important; color: var(--text-3) !important; }
  /* the three levels as distinct labels on their own line (inks: ≥ 4.5:1 on every dark surface) */
  .levels { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .lv { display: inline-flex; align-items: center; gap: 0.5ch; padding: 4px var(--s-3); border-radius: 999px; border: 1px solid currentColor; font: 600 14px/1.4 var(--font-mono); }
  .observed { color: var(--ink-ok); }
  .derived { color: var(--ink-write); }
  .inferred { color: var(--accent); font-style: italic; }
</style>
