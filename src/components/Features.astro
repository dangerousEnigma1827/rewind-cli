---
// Three pieces of product information, laid out openly (no cards): a thin ultraviolet rule, a heading, a sentence.
import { testMetric, eventMetric } from '../lib/home';
---
<section id="features" class="features" aria-labelledby="features-title">
  <h2 id="features-title" class="visually-hidden">What Rewind does</h2>
  <ul>
    <li>
      <h3><span class="num">{testMetric.big}</span> {testMetric.unit}</h3>
      <p>{testMetric.text}</p>
      <p class="src">Rewind’s own test suite, at the published version</p>
    </li>
    <li>
      <h3><span class="num">{eventMetric.big}</span> {eventMetric.unit}</h3>
      <p>{eventMetric.text}</p>
      <p class="src">Measured in Rewind’s experiment E6</p>
    </li>
    <li>
      <h3>Evidence, graded</h3>
      <p class="levels" aria-label="Evidence levels">
        <span class="lv observed"><span aria-hidden="true">●</span> Observed</span>
        <span class="lv derived"><span aria-hidden="true">◆</span> Derived</span>
        <span class="lv inferred"><span aria-hidden="true">?</span> Inferred</span>
      </p>
      <p>Every finding is marked as observed, derived, or inferred. When Rewind cannot see something, such as a variable read, it says so.</p>
    </li>
  </ul>
</section>

<style>
  .features { max-width: var(--page-max); margin-inline: auto; padding: var(--s-7) var(--gutter) 0; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-6); }
  @media (min-width: 768px) { ul { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-7); } }
  /* a restrained ultraviolet rule, not a card */
  li { border-top: 1px solid color-mix(in oklab, var(--accent-fill) 70%, var(--bg)); padding-top: var(--s-5); }
  h3 { margin: 0 0 var(--s-2); }
  .num { font-variant-numeric: tabular-nums; }
  li p { margin: 0 0 var(--s-2); font-size: 16px; color: var(--text-2); }
  .src { font: 400 13px/1.5 var(--font-mono) !important; color: var(--text-3) !important; }
  /* the three levels on their own line: coloured text, not badges (inks ≥ 4.5:1 on every dark surface) */
  .levels { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-4); font: 600 14px/1.6 var(--font-mono); }
  .observed { color: var(--ink-ok); }
  .derived { color: var(--ink-write); }
  .inferred { color: var(--accent); font-style: italic; }
</style>
