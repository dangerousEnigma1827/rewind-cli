---
// Section head: an eyebrow, a title that names the thing, one sentence on the mechanism (§5.9). Spacing, not borders.
interface Props { id: string; title: string; tag?: string; lede?: string }
const { id, title, tag, lede } = Astro.props;
---
<section id={id} aria-labelledby={`${id}-title`}>
  {tag && <p class="eyebrow">{tag}</p>}
  <h2 id={`${id}-title`}>{title}</h2>
  {lede && <p class="lede">{lede}</p>}
  <slot />
</section>

<style>
  section { max-width: var(--page-max); margin-inline: auto; padding: var(--s-9) var(--gutter) 0; }
  section:last-child { padding-bottom: var(--s-9); }
  h2 { margin: 0 0 var(--s-4); }
  .lede { margin: 0 0 var(--s-7); }
  @media (max-width: 639px) { section { padding-top: var(--s-8); } .lede { margin-bottom: var(--s-6); } }
</style>
