---
// Usage and commands: Rewind's own README command table at the captured commit, rendered verbatim.
import readme from '../data/capture/source/README.md?raw';
import { commands } from '../lib/depth';
const rows = commands(readme);
---
<div class="scroll">
  <table>
    <caption class="visually-hidden">Rewind commands</caption>
    <thead><tr><th scope="col">command</th><th scope="col">what it does</th></tr></thead>
    <tbody>{rows.map(([cmd, what]) => <tr><th scope="row"><code translate="no">{cmd}</code></th><td>{what.split("`").map((p, i) => (i % 2 ? <code translate="no">{p}</code> : p))}</td></tr>)}</tbody>
  </table>
</div>
<p class="meta"><code translate="no">RUN</code> is a label, an id prefix, <code>last</code> (the default), or <code>-N</code> (the Nth newest). From Rewind’s README.</p>

<style>
  .scroll { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; }
  th, td { text-align: left; vertical-align: top; padding: var(--s-3) var(--s-5) var(--s-3) 0; border-bottom: 1px solid var(--line); }
  thead th { font: 500 12px/1.3 var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-3); }
  tbody th { font-weight: 400; min-width: 16rem; }
  tbody th code { font-size: 13px; color: var(--text); overflow-wrap: anywhere; }
  td { color: var(--text-2); font-size: 15px; }
  .meta { margin-top: var(--s-4); }
  @media (max-width: 639px) { tbody th { min-width: 0; } table, tbody, tr, th, td { display: block; } thead { position: absolute; clip-path: inset(50%); } tr { border-bottom: 1px solid var(--line); padding: var(--s-3) 0; } th, td { border: 0; padding: var(--s-1) 0; } }
</style>
