---
// §4.1 #5: the experiments behind the design, bugs found and fixed, and the test count. Plain text.
import manifest from '../data/capture/manifest.json';
import { experiments, experimentsStatus, approaches, bugs } from '../lib/depth';
import { blob, short } from '../lib/site';
const status = /\*\*(.*?)\*\*/.exec(experimentsStatus.quote)![1];
---
<p class="status"><b>{status}</b> <span class="src">spikes/RESULTS.md, verbatim</span></p>
<div class="scroll">
  <table>
    <caption class="visually-hidden">Experiments E0 to E7: question, verdict, figure</caption>
    <thead><tr><th scope="col">exp.</th><th scope="col">question</th><th scope="col">verdict</th><th scope="col">what it measured</th></tr></thead>
    <tbody>{experiments.map((e) => (
      <tr><th scope="row" class="mono">{e.id}</th><td data-label="question">{e.q}</td><td data-label="verdict" class="mono v">{e.verdict}</td><td data-label="what it measured">{e.figure}</td></tr>
    ))}</tbody>
  </table>
</div>

<h3>E7: four ways to see a write, measured</h3>
<div class="scroll">
  <table>
    <thead><tr><th scope="col">approach</th><th scope="col">cost</th><th scope="col">verdict</th></tr></thead>
    <tbody>{approaches.map((a) => <tr><th scope="row">{a.name}</th><td data-label="cost" class="mono">{a.cost}</td><td data-label="verdict">{a.verdict}</td></tr>)}</tbody>
  </table>
</div>
<p class="note">RESULTS.md also calls request #3’s overwrite of <code>currentCart</code> an observed fact. The shipped engine is stricter and labels the writer ◆ derived: the write is recorded, its request is computed from async ancestry. This site follows the engine.</p>

<h3>Found and fixed while building</h3>
<ul class="bugs">
  {bugs.map((b) => (
    <li>
      <p><span class="mono id">{b.id}</span> <b>{b.title}.</b> {b.found}</p>
      <p>Fix: {b.fix} Regression test: <code translate="no">{b.test}</code>.</p>
    </li>
  ))}
</ul>

<p class="tests"><b class="num">{manifest.pytest}</b> — Rewind’s own suite (<code>pytest -q</code>) at rewind@{short}, run during the capture; most tests run real node processes end to end.</p>
<p class="prov">Sources at rewind@{short}: <a href={blob('spikes/RESULTS.md')}>spikes/RESULTS.md</a> · <a href={blob('docs/handover/ENGINEERING_LOG.md')}>docs/handover/ENGINEERING_LOG.md</a> · every figure on this section appears verbatim in them (checked by a test)</p>

<style>
  h3 { margin: 2.5rem 0 0.75rem; font-size: 1.125rem; }
  .status { margin: 0 0 1rem; }
  .src, .prov { font: 400 0.75rem/1.4 var(--font-mono); color: var(--ink-mute); }
  .scroll { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: 0.9375rem; }
  th, td { text-align: left; vertical-align: top; padding: 0.6rem 1rem 0.6rem 0; border-bottom: 1px solid var(--line); }
  thead th { font: 400 0.75rem/1.3 var(--font-mono); color: var(--ink-mute); }
  td.v { white-space: nowrap; }
  /* phones: each row becomes a block, every cell labelled with its column */
  @media (max-width: 639px) {
    table, tbody, tr, th, td { display: block; }
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    tr { border-bottom: 1px solid var(--line); padding: 0.75rem 0; }
    th, td { border: 0; padding: 0.15rem 0; }
    td[data-label]::before { content: attr(data-label) " "; font: 400 0.75rem/1.3 var(--font-mono); color: var(--ink-mute); }
    td.v { white-space: normal; }
  }
  .note { margin: 0.75rem 0 0; font-size: 0.875rem; max-width: 72ch; color: var(--ink-mute); }
  .bugs { margin: 0; padding: 0; list-style: none; display: grid; gap: 1rem; }
  .bugs li { border-left: 2px solid var(--line); padding-left: 1rem; }
  .bugs p { margin: 0 0 0.25rem; max-width: 72ch; overflow-wrap: anywhere; }
  .id { color: var(--ink-uv); }
  .tests { margin: 2.5rem 0 0.5rem; }
</style>
