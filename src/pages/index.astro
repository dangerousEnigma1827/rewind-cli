---
// Home (/): what Rewind is, the problem, a small real preview, three proven benefits, the next action.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import render from '../data/capture/source/render.json';
import { benefits } from '../lib/site';
---
<Base title="Rewind · Postmortem debugging for asynchronous Node.js" description={`${render.TAGLINE} Record a Node.js run once, then ask why: which request failed, who scheduled it, and who changed the state.`} current="home">
  <script is:inline>
    // Links from the old single page: /#investigate, /?step=N … → /investigation/; /#how, /#start … → /docs/.
    function go() {
      var h = location.hash, q = location.search;
      var inv = { '#investigate': 1, '#scenario': 1 }, docs = { '#how': '#how', '#evidence': '#evidence', '#limits': '#limits', '#start': '#install' };
      if (inv[h] || /[?&]step=/.test(q)) location.replace('/investigation/' + q);
      else if (docs[h]) location.replace('/docs/' + docs[h]);
    }
    go();
    addEventListener('hashchange', go);
  </script>
  <Hero />
  <section class="benefits" aria-labelledby="why-title">
    <h2 id="why-title" class="visually-hidden">Why Rewind is useful</h2>
    <ul>
      {benefits().map((b) => (
        <li>
          <h3>{b.title}</h3>
          <p>{b.text}</p>
          <a href={b.href}>See it in the investigation <span aria-hidden="true">→</span></a>
        </li>
      ))}
    </ul>
  </section>
  <section class="next" aria-labelledby="next-title">
    <h2 id="next-title">Follow a real bug from crash to fix</h2>
    <p class="lede">Three orders, one shared variable, one crash and one silent overcharge, investigated with Rewind’s real output.</p>
    <a class="btn" href="/investigation/">Open the investigation</a>
  </section>
</Base>

<style>
  .benefits { max-width: var(--page-max); margin-inline: auto; padding: var(--s-7) var(--gutter) 0; }
  .benefits ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-6); }
  @media (min-width: 768px) { .benefits ul { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-7); } }
  .benefits li { border-top: 1px solid var(--line); padding-top: var(--s-5); }
  .benefits h3 { margin: 0 0 var(--s-2); }
  .benefits p { margin: 0 0 var(--s-3); color: var(--text-2); font-size: 16px; }
  .benefits a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 500; }
  .next { max-width: var(--page-max); margin-inline: auto; padding: var(--s-9) var(--gutter) 0; }
  .next h2 { margin: 0 0 var(--s-3); }
  .next .lede { margin: 0 0 var(--s-6); }
  .btn { display: inline-flex; align-items: center; min-height: 48px; padding: 0 var(--s-5); border-radius: 8px; background: var(--accent); color: var(--bg); font-weight: 600; text-decoration: none; transition: transform 100ms var(--ease-out); }
  .btn:active { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) { .btn:hover { background: #A28AFF; } }
</style>
