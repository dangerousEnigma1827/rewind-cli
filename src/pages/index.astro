---
// Home (/): hero, three feature boxes, the CLI showcase, a small investigation preview, Get Started.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import CommandShowcase from '../components/CommandShowcase.astro';
import MiniInvestigation from '../components/MiniInvestigation.astro';
import HomeGetStarted from '../components/HomeGetStarted.astro';
import render from '../data/capture/source/render.json';
---
<Base title="Rewind · Postmortem debugging for asynchronous Node.js" description={`${render.TAGLINE} Record a Node.js run once, then ask why: which request failed, who scheduled it, and who changed the state.`} current="home">
  <script is:inline>
    // Links from the old single page: /#investigate, /?step=N … → /investigation/; /#how … → /docs/; /#start, /#get-started → #install.
    function go() {
      var h = location.hash, q = location.search;
      var inv = { '#investigate': 1, '#scenario': 1 }, docs = { '#how': '#how', '#evidence': '#evidence', '#limits': '#limits' };
      if (inv[h] || /[?&]step=/.test(q)) location.replace('/investigation/' + q);
      else if (docs[h]) location.replace('/docs/' + docs[h]);
      else if (h === '#start' || h === '#get-started') location.replace('/#install');
    }
    go();
    addEventListener('hashchange', go);
  </script>
  <Hero />
  <Features />
  <CommandShowcase />
  <MiniInvestigation />
  <HomeGetStarted />
</Base>
